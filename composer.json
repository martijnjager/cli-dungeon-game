{
    "name": "example/cli-dungeon",
    "description": "A simple PHP CLI dungeon exploration game",
    "license": "MIT",
    "type": "project",
    "require": {
        "php": "^8.1",
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "CliGame\\": "src/"
        }
    },
    "bin": ["bin/game"],
    "scripts": {
        "test": "phpunit",
        "start": "php bin/game"
    },
    "require-dev": {
        "symfony/var-dumper": "^7.4"
    }
}
